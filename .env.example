# PactPay Arena - environment template.
# Copy to .env.local (git-ignored) and fill in YOUR OWN sandbox values:   cp .env.example .env.local
# Every value below is a PLACEHOLDER, not a working credential. Never commit real values.
# Do NOT prefix any secret with NEXT_PUBLIC_ (that would ship it to the browser).
#
# WHAT YOU ACTUALLY NEED
#   * To browse the Arena, the flagship replay and the Cockpit: nothing. No .env file is required.
#   * To use the operator consoles (/mandate, /negotiations) with the built-in mock agents: only OPERATOR_PASSCODE
#     (16+ characters; generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))").
#   * To run the PayPal sandbox payment flow: PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET, PAYPAL_MERCHANT_ID, PAYPAL_WEBHOOK_ID
#     and a public HTTPS APP_BASE_URL. Without them the payment step says it cannot start; nothing is simulated in its place.
#   * To use a real AI model: AGENT_MODE=llm, ANTHROPIC_API_KEY and AGENT_MODEL. Optional; the mocks are the default.
# A value that still starts with "replace-with-" is treated as UNSET, never as a credential.

# --- App ---------------------------------------------------------------
# "local" (default) for development and tests. "demo" is for a hosted public demo and is set by the hosting
# configuration (render.yaml), not here: it adds startup checks (https APP_BASE_URL, operator passcode) and protections.
# PayPal is sandbox-only in both. See docs/DEPLOYMENT.md.
DEPLOY_MODE=local
# Public base URL of this app (used for PayPal return URLs / webhooks).
APP_BASE_URL=http://localhost:3000
# SQLite file path (git-ignored). Create it with `npm run db:migrate`; see docs/DATABASE.md.
DATABASE_PATH=./data/pactpay.db

# --- PayPal (SANDBOX ONLY) ---------------------------------------------
# The app refuses to start with anything other than "sandbox".
PAYPAL_ENV=sandbox
# Must be the sandbox host; any other value is rejected.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# From developer.paypal.com > Apps & Credentials > Sandbox. Leave blank until you have them.
# Set both or neither.
PAYPAL_CLIENT_ID=replace-with-your-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-your-sandbox-client-secret
# Webhook ID of the listener you create for https://<your public host>/api/webhooks/paypal. Without it the endpoint answers 503 and trusts nothing.
# It is read from here only, never from a message. Keep it out of source control.
PAYPAL_WEBHOOK_ID=replace-with-your-sandbox-webhook-id
# The sandbox BUSINESS account id (Developer Dashboard > Sandbox > Accounts) that must receive the funds. An id, not a secret.
# Without it the app refuses to authorize a payment because it cannot verify the payee. Blank until you have it.
PAYPAL_MERCHANT_ID=
# Per PayPal call, 1000-60000 ms. Blank = 15000.
PAYPAL_TIMEOUT_MS=
# payment_source (default) or application_context: where return/cancel URLs go in the create-order request.
PAYPAL_EXPERIENCE_CONTEXT=

# --- Agents ------------------------------------------------------------
# "scripted" = deterministic mock agents, no key, no network (default).
# "llm" enables a real provider (see AGENT_PROVIDER). It REQUIRES that provider's key and AGENT_MODEL below,
# and a model is only used when the operator presses "Run with the AI model" in /negotiations. See docs/AGENTS.md section 9.
AGENT_MODE=scripted
# Per model call in milliseconds (100-120000). Blank = 15000 for the mocks, 60000 with a real model.
AGENT_TIMEOUT_MS=
# Attempts per agent step (1-5).
AGENT_MAX_ATTEMPTS=3
# Only used when AGENT_MODE=llm: "anthropic" (Anthropic Messages API, default) or "groq" (Groq's OpenAI-compatible API, free tier).
AGENT_PROVIDER=anthropic
# Only used when AGENT_MODE=llm. Your choice of model id from your account; there is no default. For groq, for example openai/gpt-oss-120b.
AGENT_MODEL=
# Output budget per call, 1024-32000 (thinking tokens count toward it). Blank = 8192.
AGENT_MAX_OUTPUT_TOKENS=
# Server-side only; never use a NEXT_PUBLIC_ name. Put the real key in .env.local (git-ignored), never in this file.
ANTHROPIC_API_KEY=
# Used instead when AGENT_PROVIDER=groq (a key from console.groq.com).
GROQ_API_KEY=

# --- Operator access (demo-grade auth; required for the /mandate and /negotiations consoles) ---
# Minimum 16 characters. Never share it with an AI agent; see docs/MANDATE.md.
OPERATOR_PASSCODE=replace-with-a-long-random-passcode
