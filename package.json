{
  "name": "pactpay-arena",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "PactPay Arena - agents negotiate, code enforces, PayPal settles. Hackathon demo; PayPal Sandbox only.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "adversarial": "vitest run test/adversarial --reporter=./test/adversarial/reporter.ts",
    "benchmark": "vitest run --config vitest.benchmark.config.ts",
    "adversarial:catalog": "vitest run test/adversarial/catalog.test.ts -u",
    "test:watch": "vitest",
    "db:migrate": "node scripts/db.ts migrate",
    "db:status": "node scripts/db.ts status",
    "db:seed": "node scripts/db.ts seed",
    "db:reset": "node scripts/db.ts reset",
    "agents:smoke": "node scripts/agents-smoke.ts",
    "agents:attack": "node scripts/agents-attack.ts",
    "paypal:smoke": "node scripts/paypal-smoke.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "start:demo": "node scripts/start.ts",
    "verify:deployment": "node scripts/verify-deployment.ts",
    "e2e": "npm run build && playwright test",
    "e2e:run": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "next": "^16.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
